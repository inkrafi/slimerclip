# ── Wajib ─────────────────────────────────────────────
# API key Gemini milik server (dipakai admin & jatah gratis pengguna). Buat di https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ── Login (kosongkan semua di bagian ini = mode lokal tanpa login, Anda sebagai admin) ──
# Supabase Dashboard → Project Settings → API
SUPABASE_URL=
# Secret key (sb_secret_...) atau service_role key lama. JANGAN pernah taruh di frontend.
SUPABASE_SECRET_KEY=
# Hanya untuk proyek lama yang memakai JWT secret (HS256). Proyek baru tidak perlu.
SUPABASE_JWT_SECRET=
# String acak panjang; dipakai mengenkripsi API key pengguna & menandatangani link klip.
# Buat dengan: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Jangan diganti setelah ada pengguna (API key tersimpan tidak bisa dibuka lagi).
APP_SECRET=
# Email admin (pisahkan dengan koma): tanpa batas & boleh render langsung dari link YouTube
ADMIN_EMAILS=

# ── Batas pengguna biasa (opsional, ini nilai bawaannya) ──
FREE_ANALYSES=3
RENDER_DAILY_LIMIT=3
# Tinggi maks video sumber dari YouTube (1080/1440/2160). Lebih tinggi = klip lebih tajam, unduhan lebih besar
SOURCE_MAX_HEIGHT=1440
# Klip pratinjau (render pertama tanpa caption, untuk diedit) per pengguna per hari
PREVIEW_DAILY_LIMIT=10
SERVER_KEY_DAILY_CAP=40
USER_UPLOAD_MAX_MB=500
USER_UPLOAD_MAX_MINUTES=90

# ── Server ──
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
# Isi 1 jika berjalan di belakang reverse proxy (hosting)
TRUST_PROXY=0
# URL publik backend untuk link klip (opsional, default dari request)
PUBLIC_BACKEND_URL=

# ── Transkrip (opsional) ──
# Proxy untuk youtube-transcript-api, mis. http://user:pass@host:port
TRANSCRIPT_PROXY=
# 0 = jangan transkrip dengan Whisper saat YouTube tidak memberi transkrip
TRANSCRIPT_WHISPER_FALLBACK=1
