NEXT_PUBLIC_PYTHON_BACKEND_URL=http://127.0.0.1:5000

# Login Google lewat Supabase. Kosongkan = mode lokal tanpa login.
# Supabase Dashboard → Project Settings → API: Project URL & publishable key (aman untuk browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Kontak di halaman jasa. WhatsApp untuk pengunjung Indonesia (format 6281234567890), email & booking call untuk luar negeri.
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_BOOKING=

# Bahasa & harga mengikuti negara IP. Header negara yang dipercaya (Cloudflare mengirim cf-ipcountry).
# Tanpa header ini semua pengunjung produksi melihat versi Inggris/USD.
GEO_COUNTRY_HEADER=cf-ipcountry
# Hanya saat pengembangan lokal: negara yang disimulasikan (ID atau US).
GEO_DEV_COUNTRY=ID
